# ========================================================
# FlowPilot Environment Configuration (.env.example)
# Copy this file to .env and provide your credentials.
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PayPal Developer Sandbox Configuration
# 1. Sign in to https://developer.paypal.com/dashboard/
# 2. Go to "Apps & Credentials" -> Sandbox tab -> Create App (or select Default Application)
# 3. Copy the Client ID and Secret below.
# 4. Set PAYPAL_MODE to "sandbox" (or "demo" to use rich offline sample records)
PAYPAL_MODE=demo
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here

# Supabase PostgreSQL Configuration (Optional for persistence)
# 1. Create a project at https://supabase.com
# 2. Go to Project Settings -> API to find Project URL and Anon/Service Role Key
# 3. Run the schema script in server/db/schema.sql in the Supabase SQL Editor
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
